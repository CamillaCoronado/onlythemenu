# firebase admin (server only). leave unset to run against /seed json locally.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
# shared secret for /api/revalidate (also used as vercel ISR bypassToken)
REVALIDATE_SECRET=
# comma-separated firebase uids allowed into /admin
ADMIN_UIDS=
# public site origin, used for sitemap + og + json-ld
PUBLIC_SITE_URL=https://onlythemenu.com
# firebase web config — only used by /login (owners + admin). never loaded on menu pages.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
